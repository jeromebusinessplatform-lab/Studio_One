{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --import ./server/preload.ts server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server/preload.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/preload.cjs",
    "start": "node --require ./dist/preload.cjs dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "reset:prelaunch": "tsx scripts/resetPrelaunchData.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.19.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "fast-average-color": "^9.5.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.6.0",
    "form-data": "^4.0.6",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.0.1",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.21",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.2",
    "@types/express": "^4.17.21",
    "tsx": "^4.21.0"
  }
}
