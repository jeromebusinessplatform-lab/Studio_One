# Server-side secrets. Never expose these through Vite/client environment variables.
GEMINI_API_KEY=""
APP_URL=""
GEOAPIFY_API_KEY=""
TAGGUN_API_KEY=""

# Required for server-side admin authentication.
ADMIN_ACCESS_CODE=""
# Strong random secret used to sign the HttpOnly admin session cookie.
# If omitted, ADMIN_ACCESS_CODE is used as the signing secret.
ADMIN_SESSION_SECRET=""

# Firebase Admin server credential. Prefer a secret-manager value containing the
# complete service-account JSON. Alternatively use Google Application Default
# Credentials via GOOGLE_APPLICATION_CREDENTIALS in the runtime environment.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Required for production Telegram initData verification.
TELEGRAM_BOT_TOKEN=""
