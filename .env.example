# Strong random secret used to sign the HttpOnly admin session cookie.
# If omitted, ADMIN_ACCESS_CODE is used as the signing secret.
ADMIN_SESSION_SECRET=""

# Telegram bot integration.
TELEGRAM_BOT_TOKEN=""
