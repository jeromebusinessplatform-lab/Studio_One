{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store inventory product or combination bundle item",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "subname": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "costing": { "type": "number" },
        "stock": { "type": "number" },
        "available": { "type": "boolean" },
        "badge": { "type": "string", "enum": ["NEW", "SALE", "LOW_STOCK", ""] },
        "badgeExpiry": { "type": "string" },
        "image": { "type": "string" },
        "sortOrder": { "type": "number" },
        "isCombination": { "type": "boolean" },
        "bundleItems": { "type": "array" },
        "bundleCalculatedPrice": { "type": "number" }
      },
      "required": ["name", "price", "stock", "available"]
    },
    "Courier": {
      "title": "Courier",
      "description": "Courier fleet delivery partner config",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "tag": { "type": "string", "maxLength": 50 },
        "baseFare": { "type": "number" },
        "baseDistanceKm": { "type": "number" },
        "perKmCharge": { "type": "number" },
        "platformFee": { "type": "number" },
        "platformFeeEnabled": { "type": "boolean" },
        "nightDifferentialFee": { "type": "number" },
        "nightDifferentialEnabled": { "type": "boolean" },
        "surchargeFee": { "type": "number" },
        "surchargeEnabled": { "type": "boolean" },
        "isAvailable": { "type": "boolean" },
        "estimatedMinutes": { "type": "string" }
      },
      "required": ["name", "baseFare", "isAvailable"]
    },
    "Config": {
      "title": "Config",
      "description": "System settings and categories",
      "type": "object",
      "properties": {
        "list": { "type": "array" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog products and bundle offerings"
    },
    "/couriers/{courierId}": {
      "schema": "Courier",
      "description": "Logistics fleet and courier configurations"
    },
    "/config/{configId}": {
      "schema": "Config",
      "description": "Global store configuration and categories"
    },
    "/orders/{orderId}": {
      "schema": "object",
      "description": "Customer orders and fulfillment transactions"
    },
    "/customers/{customerId}": {
      "schema": "object",
      "description": "Customer VIP profiles and membership data"
    },
    "/charges/{chargeId}": {
      "schema": "object",
      "description": "Platform charges and service fees"
    },
    "/discounts/{discountId}": {
      "schema": "object",
      "description": "Promotional coupon codes"
    }
  }
}
